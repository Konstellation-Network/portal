# Copy to apps/api/.env for local development. Never commit a real .env.

# Local Postgres from compose.yaml (`docker compose up -d`).
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

PORT=8080
LOG_LEVEL=info

# Origins allowed to call the API from a browser (comma-separated).
WEB_ORIGINS=http://localhost:5173

# Secrets the web app's Pages Function sends in X-Origin-Auth (comma-separated,
# two during a rotation). Leave empty locally; production refuses to start without it.
ORIGIN_AUTH_SECRETS=

# gcp | contabo | local
PLATFORM=local
